[Unit]
Description=Verified Agent State Ledger backup
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
Environment=ENV_FILE=%h/.config/agent-state-ledger-backup/env
ExecStart=/usr/bin/bash %h/.local/libexec/ledger-backup-run
Nice=10
IOSchedulingClass=best-effort
IOSchedulingPriority=7
